{
  "extends": "../config/tsconfig.json",
  "include": ["src", "tests", "index.js", "rn-harness.config.mjs"],
  "references": [
    { "path": "../packages/react-native-nitro-sqlite" },
    { "path": "../packages/react-native-nitro-sqlite-drizzle" }
  ],
  "compilerOptions": {
    "paths": {
      "react-native-nitro-sqlite": [
        "../packages/react-native-nitro-sqlite/src/index.ts"
      ],
      "react-native-nitro-sqlite-drizzle": [
        "../packages/react-native-nitro-sqlite-drizzle/src/index.ts"
      ],
      "react-native-nitro-sqlite-drizzle/*": [
        "../packages/react-native-nitro-sqlite-drizzle/*"
      ],
      "@nitro-sqlite/*": ["../packages/react-native-nitro-sqlite/src/*"],
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    }
  }
}
