{
  "name": "react-native-nitro-sqlite-workspace",
  "version": "10.1.0",
  "packageManager": "bun@1.3.1",
  "private": "true",
  "workspaces": [
    "packages/*",
    "example",
    "example/macos",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/margelo/react-native-nitro-sqlite.git"
  },
  "author": "Margelo <hello@margelo.com> (https://github.com/margelo)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/margelo/react-native-nitro-sqlite/issues"
  },
  "homepage": "https://sqlite.margelo.com",
  "scripts": {
    "postinstall": "patch-package",
    "typecheck": "tsc --build",
    "lint": "bun sqlite lint && bun example lint",
    "lint-cpp": "./scripts/clang-format.sh",
    "prettier": "prettier --write .",
    "clean": "rm -rf **/.tsbuild **/tsconfig.tsbuildinfo node_modules packages/react-native-nitro-sqlite/node_module packages/react-native-nitro-sqlite/lib",
    "check:lockfile": "bun scripts/check-bun-lockfile.ts",
    "sync:lockfile": "bun scripts/sync-bun-lockfile.ts",
    "test:release": "bun test scripts/sync-bun-lockfile.test.ts && node --test scripts/release.test.ts scripts/generate-release-notes.test.ts scripts/publish-release.test.ts",
    "sqlite": "bun --cwd packages/react-native-nitro-sqlite",
    "example": "bun --cwd example",
    "docs": "bun --cwd docs",
    "typecheck:release": "tsc -p tsconfig.release.json"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "patch-package": "^8.0.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-nitro-modules": "0.37.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-proposal-decorators": "^7.20.5",
    "@babel/preset-env": "^7.25.4",
    "@babel/runtime": "^7.25.4",
    "@eslint/js": "^9.10.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@tsconfig/react-native": "^2.0.2",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "jsonc-parser": "^3.3.1",
    "nitrogen": "0.37.1",
    "prettier": "^3.6.2",
    "typeorm": "1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.3",
    "release-please": "17.6.0"
  }
}
