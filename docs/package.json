{
  "name": "@nitro-sqlite/docs",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate:api": "typedoc && node scripts/check-api.mjs",
    "dev": "bun run generate:api && fumadocs-mdx && next dev --webpack",
    "build": "bun run generate:api && fumadocs-mdx && next build --webpack",
    "start": "next start",
    "typecheck": "bun run generate:api && fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.9.2",
    "fumadocs-mdx": "15.0.9",
    "fumadocs-ui": "16.9.2",
    "lucide-react": "1.17.0",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.2",
    "typedoc-plugin-markdown": "^4.13.1"
  }
}
